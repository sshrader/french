# Copy to .env and edit. Nothing here is required for a first run.

# --- client (exposed to the browser, so never put secrets here) ---
# devnet, testnet or mainnet-beta. Phantom must be on the same network (see README).
VITE_CLUSTER=devnet
# Optional. The public devnet RPC is rate limited; a free Helius/QuickNode devnet URL is smoother.
# This URL is visible to anyone who opens the site, so use a key restricted to devnet.
VITE_RPC_URL=

# --- server (private) ---
PORT=8787
# Same cluster as the client. The server uses it to verify new coins on chain.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public address of the server, used to build metadata links in local mode.
PUBLIC_BASE_URL=http://localhost:8787

# Metadata storage. Leave PINATA_JWT empty to run in local mode.
# Local mode works for testing the flow, but wallets and explorers on the internet
# cannot fetch http://localhost links, so the coin image will not show up in Phantom.
# With a Pinata JWT (free account) images and metadata go to IPFS and show up everywhere.
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io

# --- the cats' AI brain (server only, never put these in a VITE_ variable) ---
# Any OpenAI-compatible chat API works. Leave LLM_API_KEY empty and the cats use canned lines.
# Groq (free tier, no card): create a key at https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# If you get "model_not_found", your account may not have access to that model. See the model
# list at https://console.groq.com/docs/models and try another, for example openai/gpt-oss-120b
# or llama-3.1-8b-instant.
# Other providers: set the three values above from their docs. Model names change, so copy the
# current one from the provider. Examples of base URLs:
#   Cerebras  https://api.cerebras.ai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Local Ollama http://localhost:11434/v1  (any non-empty LLM_API_KEY)

# Free tiers have daily caps. The server stops calling the model after this many calls a day
# and falls back to canned lines. Keep it below your provider's limit.
LLM_DAILY_LIMIT=800
# Minutes between a cat's diary entries. Each coin varies from half to one and a half times this.
# Use 1 while testing.
CAT_POST_MINUTES=30

# Market cap chart on coin pages.
# demo = made-up randomly moving numbers (default, fine for devnet testing)
# live = real market cap from DexScreener using the coin's mint address (mainnet coins that trade on a DEX)
MARKET_MODE=demo

# --- Trading on a Meteora bonding curve ---
# Run `npm run dbc-config` once. It prints these two lines (same value in both). Leave empty for plain tokens with no trading.
DBC_CONFIG=
VITE_DBC_CONFIG=
# Most SOL a creator may spend on the optional block-zero dev buy at launch (client-side limit).
VITE_MAX_DEV_BUY_SOL=5
# Optional curve settings, read by `npm run dbc-config` (market caps are in SOL):
# DBC_INITIAL_MC=30
# DBC_MIGRATION_MC=300
# DBC_FEE_BPS=100
# DBC_CREATOR_FEE_PCT=0

# --- Production / mainnet (see docs/MAINNET.md) ---
# Must be "mainnet-beta" on the real deployment. The server checks it against the RPC and refuses to start if they disagree.
SOLANA_CLUSTER=
# Wallet file the partner scripts sign with. On mainnet keep it OUTSIDE the repo. Default: .devnet-keypair.json
PARTNER_KEYPAIR=
# Beta gate: comma-separated wallets allowed to launch. Empty = anyone.
LAUNCH_ALLOWLIST=
MAX_LAUNCHES_PER_WALLET_PER_DAY=3
# Comma-separated ISO country codes to block (needs a CDN that sends a country header, such as Cloudflare). Ask your lawyer.
BLOCKED_COUNTRIES=
# Set to 1 when behind one proxy/CDN so rate limits see real visitor IPs.
TRUST_PROXY=
# Send Strict-Transport-Security (only once HTTPS works).
HSTS=
API_PER_MINUTE=240

# Wallet that may claim trading fees, SET FOREVER when the config is created (read by `npm run dbc-config`).
# On mainnet use a hardware wallet or multisig address, not a key file. Empty = the key-file wallet (devnet only).
DBC_FEE_CLAIMER=
# Same address for the browser, so /#/admin shows only to that wallet.
VITE_FEE_CLAIMER=
